# Isi lalu simpan sebagai .env (jangan dibagikan)
SHEET_URL=https://script.google.com/macros/s/XXXX/exec
SHEET_TOKEN=isi-teks-acak-panjang

# MySQL (menggantikan Google Sheets). Bila diisi, SHEET_URL/SHEET_TOKEN tidak dipakai.
DATABASE_URL=mysql://user:password@host:3306/lastdance
# Isi 1 bila server MySQL mewajibkan SSL (mis. layanan cloud).
DATABASE_SSL=0
